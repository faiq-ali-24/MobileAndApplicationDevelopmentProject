<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/cancel_iconProduct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/close_24px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.041"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.022" />

    <HorizontalScrollView
        android:id="@+id/horizontalScrollView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/cancel_iconProduct"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="200sp"
                android:layout_height="200sp"
                android:layout_margin="8sp"
                android:scaleType="centerCrop"
                android:layout_weight="1"
                android:layout_marginEnd="8sp"
                android:src="@drawable/watchimage"/>

            <ImageView
                android:layout_width="200sp"
                android:layout_height="200sp"
                android:layout_margin="8sp"
                android:scaleType="centerCrop"
                android:layout_weight="1"
                android:layout_marginEnd="8sp"
                android:src="@drawable/watchimage"/>

            <ImageView
                android:layout_width="200sp"
                android:layout_height="200sp"
                android:layout_margin="8sp"
                android:scaleType="centerCrop"
                android:layout_weight="1"
                android:layout_marginEnd="8sp"
                android:src="@drawable/watchimage"/>


        </LinearLayout>
    </HorizontalScrollView>


    <TextView
        android:id="@+id/textViewBelowScroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:text="Saamaan.pk"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/horizontalScrollView" />


    <TextView
        android:id="@+id/textViewProductDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Generic 18W Qualcomm 3.0 Charger"
        android:textColor="@color/black"
        android:textSize="23sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.125"
        app:layout_constraintStart_toStartOf="@+id/textViewBelowScroll"
        app:layout_constraintTop_toBottomOf="@id/textViewBelowScroll" />

    <TextView
        android:id="@+id/textViewPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:text="RS649"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.003"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewProductDescription" />

    <TextView
        android:id="@+id/textViewSelectQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:text="Select the quantity:"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewPrice" />

    <ImageButton
        android:id="@+id/quantityButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Decrease quantity"
        android:src="@drawable/arrow_cool_down_24px"
        app:layout_constraintBottom_toBottomOf="@+id/editTextQuantity"
        app:layout_constraintEnd_toStartOf="@+id/editTextQuantity"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@id/textViewSelectQuantity"
        app:layout_constraintTop_toTopOf="@+id/editTextQuantity"
        app:layout_constraintVertical_bias="1.0"
        tools:ignore="ImageContrastCheck" />

    <EditText
        android:id="@+id/editTextQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="44dp"
        android:ems="3"
        android:background="@drawable/edittext_border"
        android:hint="0"
        android:inputType="number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.567"
        app:layout_constraintStart_toEndOf="@+id/textViewSelectQuantity"
        app:layout_constraintTop_toBottomOf="@id/textViewPrice"
        tools:ignore="SpeakableTextPresentCheck" />


    <ImageButton
        android:id="@+id/increaseQuantityButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#8FE3CF"
        android:contentDescription="Increase quantity"
        android:src="@drawable/arrow_warm_up_24px"
        app:layout_constraintBottom_toBottomOf="@+id/editTextQuantity"
        app:layout_constraintStart_toEndOf="@+id/editTextQuantity"
        app:layout_constraintTop_toTopOf="@id/editTextQuantity"
        app:layout_constraintVertical_bias="1.0"
        tools:ignore="ImageContrastCheck" />

    <Button
        android:id="@+id/buyNowButton"
        android:layout_width="181dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="#8FE3CF"
        android:text="Buy Now"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewSelectQuantity" />


    <Button
        android:id="@+id/addToCartButton"
        android:layout_width="181dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="#D3D3D3"
        android:text="Add to Cart"
        android:textColor="#000000"
        android:textSize="18sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="@+id/buyNowButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@id/buyNowButton"
        app:layout_constraintTop_toBottomOf="@id/textViewSelectQuantity"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/textViewInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="Description:"
        android:textColor="#000000"
        android:textSize="16sp"
        android:background="#F0F0F0"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/addToCartButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <TextView
        android:id="@+id/paragraphTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:textColor="#000000"
        android:textSize="16sp"
        android:padding="12dp"
        android:text="Discover the advanced capabilities of BEME Buds Ultimate, the latest evolution in our earbuds lineup. Featuring a built-in display on the buds case, these earbuds offer unparalleled control over your listening experience with features like noise reduction, music play/pause, find my function, volume control, equalizer, time settings, language switching, alarm settings, wallpaper switching, flashlight function, call mute, social media control, and a camera shutter button. Everything you need is conveniently accessible right from the display."
        app:layout_constraintTop_toBottomOf="@id/textViewInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <ImageView
        android:id="@+id/e1"
        android:layout_marginTop="0dp"
        android:src="@drawable/e1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        android:adjustViewBounds="true"
        android:scaleType = "fitCenter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/paragraphTextView" />

    <ImageView
        android:id="@+id/e2"
        android:scaleType = "fitCenter"
        android:adjustViewBounds="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:src="@drawable/e2"
        app:layout_constraintTop_toBottomOf="@id/e1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textViewCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="Category:"
        android:textColor="#000000"
        android:textSize="16sp"
        android:background="#F0F0F0"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/e2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <TextView
        android:id="@+id/categoryBestSelling"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:clickable="true"
        android:focusable="true"
        android:text="BEST SELLING PRODUCTS"
        android:textColor="#8FE3CF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/textViewCategory"
        app:layout_constraintTop_toBottomOf="@id/textViewCategory" />

    <TextView
        android:id="@+id/categoryNewest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:text="NEWEST PRODUCTS"
        android:textColor="#8FE3CF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/categoryBestSelling"
        app:layout_constraintTop_toBottomOf="@id/categoryBestSelling" />


    <TextView
        android:id="@+id/categoryPowerBanksAndCharger"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:text="POWER BANKS AND CHARGER"
        android:textColor="#8FE3CF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/categoryNewest"
        app:layout_constraintTop_toBottomOf="@id/categoryNewest" />


    <TextView
        android:id="@+id/textViewTags"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:background="#F0F0F0"
        android:padding="12dp"
        android:text="Tags:"
        android:textColor="#000000"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/categoryPowerBanksAndCharger" />


  <TextView
    android:id="@+id/tags20wCharger"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:clickable="true"
    android:focusable="true"
    android:text="#20W CHARGER"
    android:textColor="#8FE3CF"
    android:textSize="16sp"
    android:textStyle="bold"
    app:layout_constraintStart_toStartOf="@+id/textViewTags"
    app:layout_constraintTop_toBottomOf="@id/textViewTags" />

    <TextView
        android:id="@+id/tagsBestCharger"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:clickable="true"
        android:focusable="true"
        android:text="#BEST CHARGER"
        android:textColor="#8FE3CF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/tags20wCharger"
        app:layout_constraintTop_toBottomOf="@id/tags20wCharger" />

    <TextView
        android:id="@+id/tagsCharger"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:clickable="true"
        android:focusable="true"
        android:text="#CHARGER"
        android:textColor="#8FE3CF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/tagsBestCharger"
        app:layout_constraintTop_toBottomOf="@id/tagsBestCharger" />


    <TextView
        android:id="@+id/textViewRecommendation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="You might also like"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/tagsCharger"
        app:layout_constraintTop_toBottomOf="@id/tagsCharger" />


    <HorizontalScrollView
        android:id="@+id/cardScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/textViewRecommendation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20sp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="180sp"
                android:layout_height="300sp"
                android:layout_margin="8sp"
                android:layout_marginEnd="8sp"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="false"
                android:layout_weight="1"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="0sp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="8sp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="0sp"
                        android:layout_weight="0.6"
                        android:scaleType="centerCrop"
                        android:src="@drawable/watchimage"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Product Name"
                        android:textSize="15sp"
                        android:textColor="@android:color/black"
                        android:textStyle="bold"
                        android:paddingTop="8sp" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Price: RS 500"
                        android:textSize="13sp"
                        android:textColor="@android:color/black"
                        android:paddingTop="4sp" />

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Add to Cart"
                        android:textSize="15sp"
                        android:gravity="center"
                        app:backgroundTint="@null"
                        android:background="@android:color/black"
                        android:textColor="@android:color/white"
                        android:padding="8sp"
                        android:layout_marginTop="8sp" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="180sp"
                android:layout_height="300sp"
                android:layout_margin="8sp"
                android:layout_marginEnd="8sp"
                app:cardPreventCornerOverlap="false"
                android:layout_weight="1"
                app:cardUseCompatPadding="false"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="0sp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="8sp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="0sp"
                        android:layout_weight="0.6"
                        android:scaleType="centerCrop"
                        android:src="@drawable/watchimage"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Product Name"
                        android:textSize="15sp"
                        android:textColor="@android:color/black"
                        android:textStyle="bold"
                        android:paddingTop="8sp" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Price: RS 500"
                        android:textSize="13sp"
                        android:textColor="@android:color/black"
                        android:paddingTop="4sp" />

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Add to Cart"
                        android:textSize="15sp"
                        android:gravity="center"
                        app:backgroundTint="@null"
                        android:background="@android:color/black"
                        android:textColor="@android:color/white"
                        android:padding="8sp"
                        android:layout_marginTop="8sp" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="180sp"
                android:layout_height="300sp"
                android:layout_margin="8sp"
                android:layout_marginEnd="8sp"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="false"
                android:layout_weight="1"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="0sp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="8sp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="0sp"
                        android:layout_weight="0.6"
                        android:scaleType="centerCrop"
                        android:src="@drawable/watchimage"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Product Name"
                        android:textSize="15sp"
                        android:textColor="@android:color/black"
                        android:textStyle="bold"
                        android:paddingTop="8sp" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Price: RS 500"
                        android:textSize="13sp"
                        android:textColor="@android:color/black"
                        android:paddingTop="4sp" />

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Add to Cart"
                        android:gravity="center"
                        app:backgroundTint="@null"
                        android:background="@android:color/black"
                        android:textColor="@android:color/white"
                        android:padding="8sp"
                        android:layout_marginTop="8sp" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>


        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>