<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/samaanMainLogoImageView"
            android:layout_width="wrap_content"
            android:layout_height="120dp"
            android:layout_marginTop="120dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/samaanmainlogo" />

        <TextView
            android:id="@+id/signInUserNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="16dp"
            android:text="Username"
            android:textSize="18sp"
            android:padding="6dp"
            android:background="@android:color/transparent" />

        <EditText
            android:id="@+id/signInEmailView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:inputType="textEmailAddress"
            android:textSize="16sp"
            android:padding="16dp" />

        <TextView
            android:id="@+id/signInPasswordTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:text="Password"
            android:textSize="18sp"
            android:padding="6dp" />

        <EditText
            android:id="@+id/signInPasswordPasswordView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:inputType="textPassword"
            android:textSize="16sp"
            android:padding="16dp" />

        <TextView
            android:id="@+id/signInResetPasswordTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text="Reset Password"
            android:textSize="16sp"
            android:textColor="@color/light_greenish_blue"
            android:clickable="true"
            android:focusable="true" />

        <Button
            android:id="@+id/signInSignInButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/rounded_button_background"
            android:text="Sign in with email"
            app:backgroundTint="@null"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:textSize="16sp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />


        <TextView
            android:id="@+id/signInDontHaveAccountTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:text="Don't have an account?"
            android:textSize="16sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/signInSignUpTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="Sign Up"
            android:textSize="16sp"
            android:textColor="@color/light_greenish_blue"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
